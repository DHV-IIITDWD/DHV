# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
# Current stable primary model; must be enabled for your Google AI Studio project.
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated model fallback order. Remove models your key cannot access.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite

# Optional Groq fallback (only used if Gemini fails and this key is configured)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Reliability
LLM_RETRIES=2
LLM_TIMEOUT_SECONDS=45

# Upload and frontend
MAX_UPLOAD_MB=25
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DEFAULT_DATASET=../data handling/nirf_merged.csv
